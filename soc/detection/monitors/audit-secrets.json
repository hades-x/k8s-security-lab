{
  "type": "monitor",
  "name": "Kubernetes Secret Read In Detection Lab",
  "monitor_type": "query_level_monitor",
  "enabled": false,
  "schedule": {
    "period": {
      "interval": 1,
      "unit": "MINUTES"
    }
  },
  "inputs": [
    {
      "search": {
        "indices": [
          "audit-k8s-*"
        ],
        "query": {
          "size": 0,
          "query": {
            "bool": {
              "filter": [
                {
                  "terms": {
                    "verb": [
                      "get",
                      "list"
                    ]
                  }
                },
                {
                  "term": {
                    "objectRef.resource": "secrets"
                  }
                },
                {
                  "term": {
                    "objectRef.namespace": "soc-detection"
                  }
                },
                {
                  "range": {
                    "@timestamp": {
                      "gte": "now-5m",
                      "lte": "now"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  ],
  "triggers": [
    {
      "name": "Lab candidate hit",
      "severity": "3",
      "condition": {
        "script": {
          "source": "return ctx.results[0].hits.total.value > 0",
          "lang": "painless"
        }
      },
      "actions": []
    }
  ]
}
