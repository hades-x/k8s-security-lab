{
  "cluster_permissions": [
    "cluster_composite_ops_ro",
    "cluster_monitor"
  ],
  "index_permissions": [
    {
      "index_patterns": [
        "zeek-*",
        "audit-k8s-*",
        "falco-*"
      ],
      "allowed_actions": [
        "read"
      ]
    }
  ],
  "tenant_permissions": [
